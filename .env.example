DATABASE_URL="file:./dev.db"
# In production: required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-in-production"
PORT=3000

# Optional (defaults shown; "prod" = NODE_ENV=production)
# LOG_LEVEL=info                      # trace | debug | info | warn | error | silent
# REQUIRE_HTTPS=false                 # prod: true. Redirects GET/HEAD to https, refuses other plain-HTTP requests
# TLS_CERT_FILE=                      # native HTTPS; usually TLS ends at a reverse proxy instead
# TLS_KEY_FILE=
# TRUST_PROXY_HOPS=0                  # proxies in front of the app (client IP + X-Forwarded-Proto)
# CORS_ORIGINS=                       # comma-separated allow-list. Default: any localhost port; prod: none
# DOCS_ENABLED=true                   # Swagger UI at /api/docs. prod: false
# AUTH_RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
# REGISTER_RATE_LIMIT_MAX=100         # registrations per IP per window (0 = off)
# LOGIN_RATE_LIMIT_MAX=10             # failed logins per IP + email per window (0 = off)
