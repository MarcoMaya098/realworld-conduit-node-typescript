{
  "name": "conduit-api",
  "version": "1.0.0",
  "private": true,
  "description": "RealWorld (Conduit) backend: Node.js + TypeScript + Express + Prisma + SQLite",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "bash scripts/run-api-tests.sh",
    "test:api:bruno": "bash scripts/run-api-tests-bruno.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "4.1.12"
  }
}
